# 이 파일을 .env 로 복사한 뒤 사용하세요.
# cp .env.example .env
#
# 브라우저가 호출할 API base URL.
# 개발 서버(npm run dev)는 vite proxy 가 /api → http://localhost:8080 (로컬 백엔드) 으로
# 넘겨주므로 값이 없어도 client.js 가 기본값 '/api' 를 사용합니다 (vite.config.js 참고).
#
# 배포 환경 주소는 배포 방식이 정해지면 이 파일에 별도 안내를 추가합니다.
VITE_API_BASE_URL=/api

# 백엔드에 정식 인증이 아직 없어 X-User-Id 헤더로 사용자를 임시 식별합니다.
# 로컬 백엔드 seed 데이터에 맞는 사용자 ID로 바꿔서 사용하세요.
VITE_DEV_USER_ID=1
